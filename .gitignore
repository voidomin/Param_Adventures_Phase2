# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
test_results.txt
test_summary.txt
results.json
get_failures.js
repair-pkg.js

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Database Backups
*.sql
!prisma/migrations/**/*.sql

# Local-only dev/verification helpers (throwaway scripts against a local
# DB, never meant to ship) -- see scripts/ for the naming convention.
scripts/dev-*.mjs
scripts/dev-*.ts
scripts/.dev-verify-screenshots/

# Auto-generated by `next dev`'s agentRules experiment on every local
# boot -- not something we author or want committed.
/AGENTS.md
/CLAUDE.md
